# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，不会入库）

# LLM API Key（默认 DeepSeek：https://platform.deepseek.com 注册获取）
LLM_API_KEY=sk-xxxxxxxx

# 可选：企业微信/钉钉/飞书群机器人 webhook（留空则不发送告警）
NOTIFY_WEBHOOK_URL=

# 钉钉推送（企业开放平台"企业内部应用"→ 工作通知，发给个人）
# 创建步骤见 README「周报推送」章节；在 open-dev.dingtalk.com 创建应用后填入：
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# 收件人 userid（钉钉通讯录中的 userId，多个用逗号分隔）
DINGTALK_USERIDS=
